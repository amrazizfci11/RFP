{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=attendance_db;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "your-super-secret-key-that-should-be-at-least-32-characters-long",
    "Issuer": "AttendanceSystem",
    "Audience": "AttendanceSystemClients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Storage": {
    "LocalPath": "uploads",
    "BaseUrl": "https://localhost:5001"
  },
  "Sms": {
    "Provider": "Unifonic",
    "ApiKey": "",
    "SenderId": ""
  },
  "Email": {
    "Provider": "SendGrid",
    "ApiKey": "",
    "FromEmail": "noreply@attendancesystem.com",
    "FromName": "Attendance System"
  },
  "Nafath": {
    "BaseUrl": "https://api.nafath.sa",
    "ClientId": "",
    "ClientSecret": ""
  },
  "AllowedHosts": "*"
}
